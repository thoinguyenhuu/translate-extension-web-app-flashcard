{
  "manifest_version": 3,
  "name": "Vocabulary Learning",
  "version": "0.2.0",
  "description": "Look up words, save to your vocabulary, review with flashcards.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://*.supabase.co/*",
    "https://generativelanguage.googleapis.com/*",
    "https://api.deepseek.com/*",
    "https://api.openai.com/*",
    "https://api.anthropic.com/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://flashcard.thoint.site/*"],
      "js": ["content-auth.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "match_about_blank": false
    }
  ],
  "action": {
    "default_title": "Vocabulary Learning",
    "default_popup": "popup.html"
  },
  "options_page": "options.html",
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
